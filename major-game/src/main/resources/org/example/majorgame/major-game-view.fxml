<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.majorgame.MajorGameController"
            styleClass="root-pane">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <top>
        <VBox spacing="6.0" styleClass="status-panel">
            <Label fx:id="locationPromptLabel" text="Current area" wrapText="true" maxWidth="700.0"
                   styleClass="trail-heading"/>
            <HBox spacing="12.0" styleClass="status-meters">
                <VBox spacing="4.0" styleClass="meter-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="juiceLabel" text="Apple juice:" styleClass="status-label"/>
                    <ProgressBar fx:id="juiceBar" maxWidth="1.7976931348623157E308" styleClass="status-bar juice-bar"/>
                </VBox>
                <VBox spacing="4.0" styleClass="meter-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="honorLabel" text="Honor:" styleClass="status-label"/>
                    <ProgressBar fx:id="honorBar" maxWidth="1.7976931348623157E308" styleClass="status-bar honor-bar"/>
                </VBox>
            </HBox>
            <Label text="Inventory" styleClass="status-label"/>
            <FlowPane fx:id="inventoryIconsPane" hgap="8.0" vgap="8.0" prefWrapLength="680.0" styleClass="inventory-grid"/>
        </VBox>
    </top>
    <center>
        <StackPane>
            <TextArea fx:id="outputArea" editable="false" wrapText="true" prefRowCount="20"/>
            <StackPane fx:id="battlePane" visible="false" managed="false" styleClass="battle-pane">
                <GridPane fx:id="battleGrid" styleClass="battle-grid"/>
                <VBox fx:id="battleActionBox" spacing="8.0" styleClass="battle-action-box"
                      StackPane.alignment="BOTTOM_RIGHT" managed="false" visible="false">
                    <Label fx:id="battleStatusLabel" text="Choose your move." wrapText="true" styleClass="battle-status-label"/>
                    <FlowPane fx:id="battleActionsPane" hgap="8.0" vgap="8.0"/>
                </VBox>
            </StackPane>
        </StackPane>
    </center>
    <bottom>
        <HBox fx:id="commandPanel" spacing="8.0" styleClass="command-panel">
            <TextField fx:id="commandField" HBox.hgrow="ALWAYS" onAction="#onSubmitCommand"
                       onKeyPressed="#onCommandFieldKeyPressed"
                       promptText="Enter command (e.g. n, take apple_juice, drink)"/>
            <Button text="Run" onAction="#onSubmitCommand" styleClass="command-button"/>
        </HBox>
    </bottom>
</BorderPane>
